# Enable only after a domain points to the server and certificate files exist.
server {
  listen 443 ssl http2;
  server_name ${LOCIQUA_DOMAIN};
  client_max_body_size 25m;
  ssl_certificate /etc/letsencrypt/live/${LOCIQUA_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${LOCIQUA_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  location / { proxy_pass http://app:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; }
}
